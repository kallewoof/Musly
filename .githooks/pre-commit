#!/bin/sh
# pre-commit: analyze, the unit tests under the coverage floor (tool/coverage.sh), then the live-server
# tests, when the commit touches Dart code, its configuration or the coverage gate.
# Enable once per clone: git config core.hooksPath .githooks
#
# It tests the working tree, not only what is staged. Formatting is not checked: upstream is not consistently
# dart-formatted, and enforcing it here would reformat unrelated upstream code in every file touched.

set -eu
cd "$(git rev-parse --show-toplevel)"

# Private strings first, on every commit: scripts/pii-check.sh in the unimouse super-project, which holds the
# patterns. Outside that checkout there is nothing to check against, which fails rather than passes.
pii="$(git rev-parse --show-superproject-working-tree)/scripts/pii-check.sh"
[ -x "$pii" ] || { echo "pre-commit FAILED: $pii not found (run this hook inside the unimouse checkout)"; exit 1; }
"$pii" || { echo "pre-commit FAILED: private strings (above)"; exit 1; }

git diff --cached --name-only |
  grep -qE '^(lib|test)/|^pubspec\.(yaml|lock)$|^analysis_options\.yaml$|^l10n\.yaml$|^coverage_floor\.txt$|^tool/coverage\.sh$' ||
  exit 0

# git exports GIT_DIR and friends to hooks. The Flutter SDK is a git checkout that reads its own version
# with git, so under them it reports 0.0.0-unknown and every pub resolution fails.
for var in $(env | sed -n 's/^\(GIT_[A-Z_]*\)=.*/\1/p'); do unset "$var"; done

fail() {
  echo ""
  echo "pre-commit FAILED: $*"
  exit 1
}

echo "pre-commit: flutter analyze"
flutter analyze --no-fatal-infos || fail "flutter analyze reported a warning or an error"

tool/coverage.sh || fail "unit tests or coverage (tool/coverage.sh)"

# Skipped unless test_server_config.json (gitignored) names a server: see test/test_config.dart.
log="$(mktemp -t musly-pre-commit.XXXXXX)"
echo "pre-commit: live-server tests (log: $log)"
if ! flutter test --reporter expanded test/integration >"$log" 2>&1; then
  sed -n '/^Failing tests:/,$p' "$log"
  fail "live-server tests; the full output is in $log"
fi
grep -E '^[0-9]+:[0-9]+ \+[0-9]+' "$log" | tail -1
rm -f "$log"
